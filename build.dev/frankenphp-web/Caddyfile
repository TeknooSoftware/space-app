# HTTP: redirect all traffic to HTTPS
{
        skip_install_trust

        {$CADDY_GLOBAL_OPTIONS}

        frankenphp {
                {$FRANKENPHP_CONFIG}
        }
}

{$CADDY_EXTRA_CONFIG}

http://localhost {
  redir https://{host}{uri} 301
}

# The Mercure hub is embedded in this container, so `https://localhost` only reaches it from the
# `web` service itself. The worker containers publish their updates from another container, where
# `localhost` is themselves: the site block must therefore also answer to a name routable on the
# Compose networks. `INTERNAL_SERVER_NAME` holds that name, and defaults to the `web` service of
# the stacks shipped with the application.
https://localhost, {$INTERNAL_SERVER_NAME:https://web} {
    tls internal

    root * /var/www/space/public

    encode zstd gzip

    # Mercure 1.0 hub, the module embedded in FrankenPHP since 1.13. The issuer must be the `iss`
    # claim of the tokens minted by the PHP services (MERCURE_JWT_ISSUER). `resource_identifier`
    # pins the audience on the public URL: the workers publish through `https://web`, and a 1.0 hub
    # otherwise derives the audience from each request and rejects their tokens with a 401.
    mercure {
        issuer {$MERCURE_TRUSTED_ISSUERS:https://localhost} {
            publisher {
                jwt {env.MERCURE_PUBLISHER_JWT_KEY} {env.MERCURE_PUBLISHER_JWT_ALG}
            }
            subscriber {
                jwt {env.MERCURE_SUBSCRIBER_JWT_KEY} {env.MERCURE_SUBSCRIBER_JWT_ALG}
            }
        }
        resource_identifier {$MERCURE_SUBSCRIBER_URL:https://localhost/.well-known/mercure}

        anonymous
        subscriptions
        cors_origins https://localhost http://localhost
    }

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Strict-Transport-Security "max-age=3600"
        Access-Control-Allow-Origin "*"
    }

    php_server {

    }
}

# As an alternative to editing the above site block, you can add your own site
# block files in the Caddyfile.d directory, and they will be included as long
# as they use the .caddyfile extension.

import Caddyfile.d/*.caddyfile

