framework:
    session:
        handler_id: Symfony\Component\HttpFoundation\Session\Storage\Handler\RedisSessionHandler

services:
    _defaults:
        autowire: true
        autoconfigure: true
        public: false

    #####################
    # Valkey (through the phpredis client; SPACE_REDIS_* are read as a deprecated fallback)
    Symfony\Component\HttpFoundation\Session\Storage\Handler\RedisSessionHandler:
        arguments:
            - '@Redis'
            - { 'prefix': 'space_session', 'ttl': 3600 }

    Redis:
        # you can also use \RedisArray, \RedisCluster, \Relay\Relay or \Predis\Client classes
        class: 'Redis'
        calls:
            - connect:
                - '%env(string:default:teknoo.space.default.redis.host:SPACE_VALKEY_HOST)%'
                - '%env(int:default:teknoo.space.default.redis.port:SPACE_VALKEY_PORT)%'
