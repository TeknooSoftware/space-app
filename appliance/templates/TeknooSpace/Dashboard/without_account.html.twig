{# templates/TeknooSpace/Dashboard/without_account.html.twig #}

{% extends '@TeknooSpace/dashboard.layout.html.twig' %}

{% block title %}{{ 'teknoo.space.text.dashboard'|trans }} - {% endblock %}

{% block containerFluidInner %}
    <div class="layout-specing">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h6 id="welcome-message" class="text-muted mb-1">
                    {{ 'teknoo.space.text.welcome_back'|trans({'user': space.user.user}) }}
                </h6>
                <h5 class="mb-0">{{ 'teknoo.space.text.dashboard'|trans }}</h5>
            </div>

            <nav aria-label="breadcrumb" class="d-inline-block mt-2 mt-sm-0">
                <ul class="breadcrumb bg-transparent rounded mb-0 p-0">
                    <li class="breadcrumb-item text-capitalize">
                        <a href="{{ path('space_dashboard') }}">{{ 'teknoo.space.text.space'|trans }}</a>
                    </li>
                    <li class="breadcrumb-item text-capitalize active" aria-current="page">
                        {{ 'teknoo.space.text.dashboard'|trans }}
                    </li>
                </ul>
            </nav>
        </div>
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-0 rounded shadow p-4">
                    <p id="without-account-message" class="text-muted mb-3">
                        {{ 'teknoo.space.text.dashboard.without_account'|trans }}
                    </p>
                    <div>
                        <a href="{{ path('space_my_settings') }}" class="btn btn-primary">
                            <i class="ti ti-user me-2"></i>{{ 'teknoo.space.action.my-settings'|trans }}
                        </a>
                        {% if supportContact is not empty %}
                            <a href="{{ path('space_support_contact') }}" class="btn btn-soft-primary">
                                <i class="ti ti-mail me-2"></i>{{ 'teknoo.space.action.contacts'|trans }}
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
