{# templates/TeknooSpace/api/Job/pending.json.twig #}
{% if taskResult.error_message is defined and taskResult.error_message is not empty %}
{% set object = {"error": {"code": taskResult.error_code|default(500), "message": taskResult.error_message}} %}
{{ object|space_api_object_serialization({}, "json", {"error": true}) }}
{% else %}
{% set object = {
    "id": taskResult.task_id,
    "api_url": url("space_api_v1_admin_job_get", {"accountId": taskResult.account_id, "projectId": taskResult.project_id, "id": taskResult.task_id}),
    "user_url": taskResult.task_url
} %}
{{ object|space_api_object_serialization({}, "json", {"error": false}) }}
{% endif %}