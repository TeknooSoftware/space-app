{# templates/TeknooSpace/Job/get.html.twig #}

{% extends '@TeknooSpace/dashboard.layout.html.twig' %}

{% block title %}{{ 'teknoo.space.title.job.pending'|trans }} - {% endblock %}

{% block containerFluidInner %}
    <div class="layout-specing">
        <div class="d-md-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0"><i class="uil uil-drill"></i> {{ 'teknoo.space.title.job.pending'|trans }}</h5>

            <nav aria-label="breadcrumb" class="d-inline-block mt-2 mt-sm-0">
                <ul class="breadcrumb bg-transparent rounded mb-0 p-0">
                    <li class="breadcrumb-item text-capitalize">
                        <a href="{{ path('space_dashboard') }}">{{ 'teknoo.space.text.space'|trans }}</a>
                    </li>
                    <li class="breadcrumb-item text-capitalize">
                        <a href="{% if is_granted('ROLE_ADMIN') %}{{ path('_teknoo_paas_admin_project_list') }}{% else %}{{ path('space_project_list') }}{% endif %}">
                            {{ 'teknoo.space.title.project.edit'|trans }}
                        </a>
                    </li>
                    {% set requestProjectId = app.request.request.get('projectId', app.request.query.get('projectId', 0)) %}
                    {% if requestProjectId > 0 %}
                        <li class="breadcrumb-item text-capitalize">
                            {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('_teknoo_paas_admin_project_edit', {'id': requestProjectId}) }}">
                            {% else %}
                            <a href="{{ path('space_project_edit', {'id': requestProjectId}) }}">
                            {% endif %}
                                {{ app.request.request.get('projectName', app.request.query.get('projectName')) }}
                            </a>
                        </li>
                    {% endif %}
                    <li class="breadcrumb-item text-capitalize active" aria-current="page">
                        <i class="uil uil-drill"></i> {{ 'teknoo.space.title.job.new'|trans }}
                    </li>
                </ul>
            </nav>
        </div>
        <div class="row">
            <div class="col-12" id="text-pending">
                <div class="d-flex align-items-center justify-content-center mt-5">
                    <img src="images/icon/clock.svg" alt="Pending job">
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascript_additonals %}
    {% set taskId = app.request.attributes.get('taskId') %}
    {#- The topic is also the subscription granted in the authorization cookie: without it the
        cookie would authorize nothing on this topic and the page would only work on a hub
        allowing anonymous subscribers. -#}
    {% set topicUrl = url('space_job_new_pending', {'taskId': taskId }) %}
    <script nonce="{{ space_nonce() }}">
        {% if mercureEnabled %}
        {#- Updates published before the subscription are replayed from the marker identified by
            the task id. Mercure 1.0 reads it from `last_event_id`, while the `lastEventId` option of
            mercure() (symfony/mercure 0.8) only emits the 0.x `lastEventID`/`Last-Event-ID`. -#}
        {% if mercureProtocolVersion == '1.0' %}
            {% set mercureSubscriptionUrl = mercure(topicUrl, {'subscribe': topicUrl}) ~ '&last_event_id=' ~ taskId|url_encode %}
        {% else %}
            {% set mercureSubscriptionUrl = mercure(topicUrl, {'lastEventId': taskId, 'subscribe': topicUrl}) %}
        {% endif %}
        const eventSource = new EventSource("{{ mercureSubscriptionUrl|escape('js') }}");

        eventSource.onmessage = event => {
          result = JSON.parse(event.data);
          if ("error_code" in result) {
            console.log(event.data);
            document.getElementById('text-pending').innerHTML = '<div class="alert alert-danger" role="alert">' + result.error_message + '</div>';
          } else {
            document.location = result.task_url;
          }
        }
        {% endif %}
    </script>
{% endblock %}
